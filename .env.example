# ─────────────────────────────────────────────────────────────
#  Copie ce fichier en `.env` (local) et renseigne les valeurs.
#  Sur Vercel, ces variables se mettent dans Settings → Environment Variables.
#  NE JAMAIS commiter le vrai `.env`.
# ─────────────────────────────────────────────────────────────

# Base de données Postgres (Neon / Supabase / autre)
# DATABASE_URL  = connexion "poolée" (utilisée par l'app)
# DIRECT_URL    = connexion directe (utilisée par les migrations Prisma)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Authentification (accès à l'ERP)
# APP_PASSWORD : ton mot de passe pour te connecter à l'ERP
# AUTH_SECRET  : une chaîne aléatoire longue (ex: `openssl rand -base64 32`)
APP_PASSWORD="change-moi"
AUTH_SECRET="change-moi-par-une-longue-chaine-aleatoire"

# ─────────── À renseigner plus tard (Phases 2 et 3) ───────────

# Boîte mail générique (Phase 2 — ingestion)
# MAILBOX_PROVIDER="imap"        # imap | gmail | microsoft
# MAILBOX_HOST=""
# MAILBOX_USER=""
# MAILBOX_PASSWORD=""

# Claude (Phase 3 — génération de la todo)
# ANTHROPIC_API_KEY=""

# Secret pour protéger l'endpoint de cron (Phase 3)
# CRON_SECRET=""
